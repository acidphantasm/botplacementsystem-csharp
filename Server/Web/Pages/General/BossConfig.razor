@page "/botplacementsystem/bossconfig"
@layout MainLayout

<style>
    .mud-divider {
    border-width: 2.5px;
    }
</style>

<MudMainContent>
    <MudContainer Class="mb-20">
        <MudTabs Centered="true" Elevation="0" Rounded="true" ApplyEffectsToContainer="false" SliderAnimation Style="line-height:4">
            <MudExpansionPanels MultiExpansion="true">
                <MudTabPanel Text="General">
                    <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="Difficulty Settings" Expanded=true>
                        <MudGrid>

                            <MudItem xs="1">
                                <MudPaper Class="d-flex justify-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <ChildContent>
                                            <MudIconButton Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                        </ChildContent>
                                        <TooltipContent>
                                            <MudText Typo="Typo.caption">This will set the boss to be 100% chance on every single map YOU have given the boss a chance to spawn on.</MudText>
                                        </TooltipContent>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Allows you to use the SPT Weekly Boss logic to force a single boss to be 100% chance." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Enable Weekly Bosses</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_enableWeeklyBosses" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_enableWeeklyBosses</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_enableWeeklyBosses"))
                                {
                                    <MudButton @onclick="undo_WeeklyBosses" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _enableWeeklyBosses != false)
                                {
                                    <MudButton @onclick="default_WeeklyBosses" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>
                            
                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Weight of Boss Difficulty. Lower is less common, higher is more common." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Easy Difficulty Weight</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                <MudButton Style="margin-top: -20px;" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">@_boss_EasyDifficulty</MudButton>
                            </MudItem>
                            <MudItem xs="5">
                                <MudSlider @bind-Value="_boss_EasyDifficulty" ValueLabel="true" Min="0" Max="100" Color="Color.Info" Size="Size.Medium" />
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_boss_EasyDifficulty"))
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="undo_Boss_Easy" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _boss_EasyDifficulty != 0)
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="default_Boss_Easy" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Weight of Boss Difficulty. Lower is less common, higher is more common." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Normal Difficulty Weight</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                <MudButton Style="margin-top: -20px;" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">@_boss_NormalDifficulty</MudButton>
                            </MudItem>
                            <MudItem xs="5">
                                <MudSlider Style="margin-top: -20px;" @bind-Value="_boss_NormalDifficulty" ValueLabel="true" Min="0" Max="100" Color="Color.Info" Size="Size.Medium" />
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_boss_NormalDifficulty"))
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="undo_Boss_Normal" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _boss_NormalDifficulty != 60)
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="default_Boss_Normal" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Weight of Boss Difficulty. Lower is less common, higher is more common." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Hard Difficulty Weight</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                <MudButton Style="margin-top: -20px;" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">@_boss_HardDifficulty</MudButton>
                            </MudItem>
                            <MudItem xs="5">
                                <MudSlider @bind-Value="_boss_HardDifficulty" ValueLabel="true" Min="0" Max="100" Color="Color.Info" Size="Size.Medium"/>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_boss_HardDifficulty"))
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="undo_Boss_Hard" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _boss_HardDifficulty != 30)
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="default_Boss_Hard" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Weight of Boss Difficulty. Lower is less common, higher is more common." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Impossible Difficulty Weight</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                <MudButton Style="margin-top: -20px;" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">@_boss_ImpossibleDifficulty</MudButton>
                            </MudItem>
                            <MudItem xs="5">
                                <MudSlider @bind-Value="_boss_ImpossibleDifficulty" ValueLabel="true" Min="0" Max="100" Color="Color.Info" Size="Size.Medium"/>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_boss_ImpossibleDifficulty"))
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="undo_Boss_Impossible" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _boss_ImpossibleDifficulty != 10)
                                {
                                    <MudButton Style="margin-top: -20px;" @onclick="default_Boss_Impossible" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                    <MudExpansionPanel Class="mud-expansion-panels-borders ma-3 pa-5" Text="Additional Spawns" Expanded=true>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudText Typo="Typo.caption">ABPS rebuilds every map's boss list from its own config. These toggles keep spawns ABPS has no config for.</MudText>
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps SPT's Halloween summoning event spawns (Event Cultist Priest, Zryachiy events, Labs Tagilla). Only present while SPT has the Halloween event active." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Halloween: Summoning Event</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalHalloweenSummon" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalHalloweenSummon</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalHalloweenSummon"))
                                {
                                    <MudButton @onclick="undo_AdditionalHalloweenSummon" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalHalloweenSummon != true)
                                {
                                    <MudButton @onclick="default_AdditionalHalloweenSummon" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps SPT's Halloween night cultists (Predvestnik) on Customs, Woods and Shoreline. Only present while SPT has the Halloween event active." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Halloween: Night Cultists</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalHalloweenNightCult" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalHalloweenNightCult</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalHalloweenNightCult"))
                                {
                                    <MudButton @onclick="undo_AdditionalHalloweenNightCult" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalHalloweenNightCult != true)
                                {
                                    <MudButton @onclick="default_AdditionalHalloweenNightCult" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps SPT's Halloween infected/zombie spawns. Only present while SPT has the Halloween event active with zombies enabled." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Halloween: Zombies</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalHalloweenZombies" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalHalloweenZombies</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalHalloweenZombies"))
                                {
                                    <MudButton @onclick="undo_AdditionalHalloweenZombies" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalHalloweenZombies != true)
                                {
                                    <MudButton @onclick="default_AdditionalHalloweenZombies" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps boss spawns from any other SPT (or modded) seasonal event. Only present while that event is active." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Other Seasonal Events</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalOtherEvents" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalOtherEvents</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalOtherEvents"))
                                {
                                    <MudButton @onclick="undo_AdditionalOtherEvents" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalOtherEvents != true)
                                {
                                    <MudButton @onclick="default_AdditionalOtherEvents" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps the vanilla snipers that spawn alongside Kaban on Streets." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Kaban's Snipers (Streets)</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalBossBoarSniper" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalBossBoarSniper</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalBossBoarSniper"))
                                {
                                    <MudButton @onclick="undo_AdditionalBossBoarSniper" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalBossBoarSniper != true)
                                {
                                    <MudButton @onclick="default_AdditionalBossBoarSniper" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps the vanilla crazy scav event on Lighthouse." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Crazy Scav Event (Lighthouse)</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalCrazyAssaultEvent" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalCrazyAssaultEvent</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalCrazyAssaultEvent"))
                                {
                                    <MudButton @onclick="undo_AdditionalCrazyAssaultEvent" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalCrazyAssaultEvent != true)
                                {
                                    <MudButton @onclick="default_AdditionalCrazyAssaultEvent" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps the vanilla Peacemaker squad on Shoreline." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Peacemaker Squad (Shoreline)</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalPeacemaker" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalPeacemaker</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalPeacemaker"))
                                {
                                    <MudButton @onclick="undo_AdditionalPeacemaker" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalPeacemaker != true)
                                {
                                    <MudButton @onclick="default_AdditionalPeacemaker" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>

                            <MudItem xs="1" />
                            <MudItem xs="4">
                                <MudPaper Class="d-flex align-center mud-width-full ma-1" Elevation="0">
                                    <MudTooltip Text="Keeps boss/faction spawns added by other mods instead of removing them. Bosses ABPS has a config for are still controlled by ABPS." Color="Color.Primary" Placement="Placement.Right" Arrow="true">
                                        <MudText>Other Mods' Boss Spawns</MudText>
                                    </MudTooltip>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6">
                                <MudPaper Class="d-flex align-center mud-width-full" Elevation="0">
                                    <MudSwitch T="bool" @bind-Value="_additionalOtherMods" Color="Color.Success" UncheckedColor="Color.Default" LabelPlacement="Placement.End">@_additionalOtherMods</MudSwitch>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="1">
                                @if (MainLayout._appUndoButtonToggle &&
                                     MainLayout.pendingChanges.Contains("_additionalOtherMods"))
                                {
                                    <MudButton @onclick="undo_AdditionalOtherMods" Variant="Variant.Filled" Color="Color.Inherit" Size="Size.Small">Undo</MudButton>
                                }
                                else if (MainLayout._appDefaultButtonToggle &&
                                         _additionalOtherMods != false)
                                {
                                    <MudButton @onclick="default_AdditionalOtherMods" Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small">Default</MudButton>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudExpansionPanel>
                </MudTabPanel>
            </MudExpansionPanels>
        </MudTabs>
    </MudContainer>
</MudMainContent>

@code {

    private bool _enableWeeklyBosses
    {
        get => ModConfig.Config.WeeklyBoss.Enable;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.WeeklyBoss.Enable);
            ModConfig.Config.WeeklyBoss.Enable = value;
        }
    }
    private void undo_WeeklyBosses() => _enableWeeklyBosses = ModConfig.OriginalConfig.WeeklyBoss.Enable;
    private void default_WeeklyBosses() => _enableWeeklyBosses = false;

    #region AdditionalSpawns
    private bool _additionalHalloweenSummon
    {
        get => ModConfig.Config.AdditionalSpawns.SeasonalEvents.HalloweenSummon;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.HalloweenSummon);
            ModConfig.Config.AdditionalSpawns.SeasonalEvents.HalloweenSummon = value;
        }
    }
    private void undo_AdditionalHalloweenSummon() => _additionalHalloweenSummon = ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.HalloweenSummon;
    private void default_AdditionalHalloweenSummon() => _additionalHalloweenSummon = true;
    private bool _additionalHalloweenNightCult
    {
        get => ModConfig.Config.AdditionalSpawns.SeasonalEvents.HalloweenNightCult;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.HalloweenNightCult);
            ModConfig.Config.AdditionalSpawns.SeasonalEvents.HalloweenNightCult = value;
        }
    }
    private void undo_AdditionalHalloweenNightCult() => _additionalHalloweenNightCult = ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.HalloweenNightCult;
    private void default_AdditionalHalloweenNightCult() => _additionalHalloweenNightCult = true;
    private bool _additionalHalloweenZombies
    {
        get => ModConfig.Config.AdditionalSpawns.SeasonalEvents.HalloweenZombies;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.HalloweenZombies);
            ModConfig.Config.AdditionalSpawns.SeasonalEvents.HalloweenZombies = value;
        }
    }
    private void undo_AdditionalHalloweenZombies() => _additionalHalloweenZombies = ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.HalloweenZombies;
    private void default_AdditionalHalloweenZombies() => _additionalHalloweenZombies = true;
    private bool _additionalOtherEvents
    {
        get => ModConfig.Config.AdditionalSpawns.SeasonalEvents.OtherEvents;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.OtherEvents);
            ModConfig.Config.AdditionalSpawns.SeasonalEvents.OtherEvents = value;
        }
    }
    private void undo_AdditionalOtherEvents() => _additionalOtherEvents = ModConfig.OriginalConfig.AdditionalSpawns.SeasonalEvents.OtherEvents;
    private void default_AdditionalOtherEvents() => _additionalOtherEvents = true;
    private bool _additionalBossBoarSniper
    {
        get => ModConfig.Config.AdditionalSpawns.VanillaExtras.BossBoarSniper;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.AdditionalSpawns.VanillaExtras.BossBoarSniper);
            ModConfig.Config.AdditionalSpawns.VanillaExtras.BossBoarSniper = value;
        }
    }
    private void undo_AdditionalBossBoarSniper() => _additionalBossBoarSniper = ModConfig.OriginalConfig.AdditionalSpawns.VanillaExtras.BossBoarSniper;
    private void default_AdditionalBossBoarSniper() => _additionalBossBoarSniper = true;
    private bool _additionalCrazyAssaultEvent
    {
        get => ModConfig.Config.AdditionalSpawns.VanillaExtras.CrazyAssaultEvent;
        set
        {
            Utils.UpdateView(value, ModConfig.OriginalConfig.AdditionalSpawns.VanillaExtras.CrazyAssaultEvent);
            ModConfig.Config.AdditionalSpawns.VanillaExtras.CrazyAssaultEvent = value;
        }
